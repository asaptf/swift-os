# Build artifacts
/build/*
!/build/.gitkeep
*.o
*.elf
*.bin
*.img
*.map

# Toolchain / sysroot (large, reproducible)
/toolchain/
/sysroot/
/userland/busybox/busybox-*/
/userland/busybox/*.tar.*

# Test model checkpoints (small, fetched on demand by scripts/fetch-model.sh)
/models/

# Editor / OS cruft
.DS_Store
*.swp
.idea/
.vscode/
.claude/

# Stray VirtualBox headless crash logs (dropped in cwd)
*-VBoxHeadless-*.log
