+
+// IPv6 support (bridge already provides swiftos_socket_ipv6, sendto/recvfrom_ipv6
+// with 16-byte network-order ip6, and AF_INET6=10).
+// This demonstrates full dual-stack from userland. The main path stays IPv4
+// for compatibility with existing tests; a future slice can make the tool
+// AF_INET6-primary or dual-listen.
+private func printIPv6(_ ip6: UnsafePointer<UInt8>) {
+  for i in 0..<8 {
+    if i > 0 { swiftos_putc(0x3A) } // ':'
+    let hi = UInt((UInt16(ip6[i*2]) << 8) | UInt16(ip6[i*2+1]))
+    printUInt(hi)
+  }
+}
+
+// Example (not executed in main path):
+// let fd6 = swiftos_socket_ipv6()
+// ... bind(fd6, port) ...
