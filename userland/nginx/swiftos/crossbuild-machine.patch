diff --git a/auto/cc/name b/auto/cc/name
--- a/auto/cc/name
+++ b/auto/cc/name
@@ -9,7 +9,11 @@ if [ "$NGX_PLATFORM" != win32 ]; then
     ngx_feature="C compiler"
     ngx_feature_name=
-    ngx_feature_run=yes
+    if test -n "$NGX_PLATFORM"; then
+        ngx_feature_run=no
+    else
+        ngx_feature_run=yes
+    fi
     ngx_feature_incs=
     ngx_feature_path=
     ngx_feature_libs=
     ngx_feature_test=
diff --git a/configure b/configure
--- a/configure
+++ b/configure
@@ -40,7 +40,20 @@ else

     echo "building for $NGX_PLATFORM"
-    NGX_SYSTEM=$NGX_PLATFORM
-    NGX_MACHINE=i386
+    # swift-os crossbuild machine overlay: upstream cross-build mode assumes
+    # i386, but our target is aarch64.  Treat --crossbuild as OS:release:machine.
+    NGX_SYSTEM=`echo "$NGX_PLATFORM" | sed -e 's/:.*//'`
+    NGX_RELEASE=`echo "$NGX_PLATFORM" \
+        | sed -n -e 's/^[^:]*:\([^:]*\).*/\1/p'`
+    NGX_MACHINE=`echo "$NGX_PLATFORM" \
+        | sed -n -e 's/^[^:]*:[^:]*:\([^:]*\).*/\1/p'`
+
+    if test -z "$NGX_RELEASE"; then
+        NGX_RELEASE=0
+    fi
+
+    if test -z "$NGX_MACHINE"; then
+        NGX_MACHINE=i386
+    fi
 fi

 . auto/cc/conf
diff --git a/auto/types/sizeof b/auto/types/sizeof
--- a/auto/types/sizeof
+++ b/auto/types/sizeof
@@ -14,7 +14,17 @@ END

 ngx_size=

-cat << END > $NGX_AUTOTEST.c
+if test -n "$NGX_PLATFORM"; then
+    case "$ngx_type" in
+        int|sig_atomic_t)
+            ngx_size=4
+        ;;
+        long|"long long"|"void *"|size_t|off_t|time_t)
+            ngx_size=8
+        ;;
+    esac
+else
+    cat << END > $NGX_AUTOTEST.c

 #include <sys/types.h>
 #include <sys/time.h>
@@ -33,14 +43,18 @@ END


-ngx_test="$CC $CC_TEST_FLAGS $CC_AUX_FLAGS \
-          -o $NGX_AUTOTEST $NGX_AUTOTEST.c $NGX_LD_OPT $ngx_feature_libs"
+    ngx_test="$CC $CC_TEST_FLAGS $CC_AUX_FLAGS \
+              -o $NGX_AUTOTEST $NGX_AUTOTEST.c $NGX_LD_OPT $ngx_feature_libs"

-eval "$ngx_test >> $NGX_AUTOCONF_ERR 2>&1"
+    eval "$ngx_test >> $NGX_AUTOCONF_ERR 2>&1"


-if [ -x $NGX_AUTOTEST ]; then
-    ngx_size=`$NGX_AUTOTEST`
+    if [ -x $NGX_AUTOTEST ]; then
+        ngx_size=`$NGX_AUTOTEST`
+    fi
+fi
+
+if test -n "$ngx_size"; then
     echo " $ngx_size bytes"
 fi
