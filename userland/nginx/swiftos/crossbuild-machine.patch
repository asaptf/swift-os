diff --git a/configure b/configure
--- a/configure	2026-07-15 10:48:00
+++ b/configure	2026-07-15 10:48:00
@@ -43,8 +43,21 @@
 
 else
     echo "building for $NGX_PLATFORM"
-    NGX_SYSTEM=$NGX_PLATFORM
-    NGX_MACHINE=i386
+    # swift-os crossbuild machine overlay: upstream cross-build mode assumes
+    # i386, but our target is aarch64.  Treat --crossbuild as OS:release:machine.
+    NGX_SYSTEM=`echo "$NGX_PLATFORM" | sed -e 's/:.*//'`
+    NGX_RELEASE=`echo "$NGX_PLATFORM" \
+        | sed -n -e 's/^[^:]*:\([^:]*\).*/\1/p'`
+    NGX_MACHINE=`echo "$NGX_PLATFORM" \
+        | sed -n -e 's/^[^:]*:[^:]*:\([^:]*\).*/\1/p'`
+
+    if test -z "$NGX_RELEASE"; then
+        NGX_RELEASE=0
+    fi
+
+    if test -z "$NGX_MACHINE"; then
+        NGX_MACHINE=i386
+    fi
 fi
 
 . auto/cc/conf
