diff --git a/auto/endianness b/auto/endianness
--- a/auto/endianness	2026-07-15 10:48:00
+++ b/auto/endianness	2026-07-15 10:48:00
@@ -13,6 +13,15 @@
 END
 
 
+# Freestanding aarch64-elf binaries are loadable on aarch64 Linux hosts and
+# hang forever when configure tries to execute them.  Our only cross target
+# (SwiftOS aarch64) is little-endian — force it when --crossbuild is set.
+if test -n "$NGX_PLATFORM"; then
+    echo " little endian"
+    have=NGX_HAVE_LITTLE_ENDIAN . auto/have
+    return
+fi
+
 cat << END > $NGX_AUTOTEST.c
 
 int main(void) {
diff --git a/auto/feature b/auto/feature
--- a/auto/feature	2026-07-15 10:48:00
+++ b/auto/feature	2026-07-15 10:48:00
@@ -12,6 +12,17 @@
 
 END
 
+# Do not execute freestanding guest binaries on the build host.  On aarch64
+# Linux the kernel will load aarch64-elf ET_EXEC probes and hang (no Linux
+# ABI).  Compile/link success is enough for crossbuild feature detection.
+if test -n "$NGX_PLATFORM"; then
+    case "$ngx_feature_run" in
+        yes|value|bug)
+            ngx_feature_run=no
+        ;;
+    esac
+fi
+
 ngx_found=no
 
 if test -n "$ngx_feature_name"; then
