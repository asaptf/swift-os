# Hetzner deploy pipeline configuration (copy to deploy.env and edit).
#
# Usage:
#   cp fixtures/hetzner/deploy.env.example build/hetzner-deploy/deploy.env
#   source build/hetzner-deploy/deploy.env
#   ./scripts/hetzner-deploy.sh preflight
#   HETZNER_CONFIRM=1 ./scripts/hetzner-deploy.sh promote

# Target server (Linux staging host for scp/dd, then SwiftOS after reboot).
HETZNER_HOST=138.199.222.99
HETZNER_SSH_USER=root
HETZNER_SSH_PORT=22
HETZNER_DISK=/dev/sda
HETZNER_REMOTE_IMAGE=/root/swift-os.img

# Login key staged into the SwiftOS image (/etc/ssh/authorized_keys).
HETZNER_AUTHORIZED_KEYS=${HOME}/.ssh/id_ed25519.pub

# Local SSH identity used to reach the server during promote (Linux or SwiftOS).
HETZNER_SSH_IDENTITY=${HOME}/.ssh/id_ed25519

# Stable SwiftOS host key seed (generated on first build if missing).
# HETZNER_HOST_SEED=build/hetzner-deploy/ssh_host_ed25519_seed

# Set to 1 to regenerate the host seed on the next build.
# HETZNER_ROTATE_HOST_KEY=0

# Health-check mode after promote: swiftos (bounded /bin/* over SSH).
HETZNER_TARGET_MODE=swiftos

# Required for destructive promote (flash + reboot).
# HETZNER_CONFIRM=0