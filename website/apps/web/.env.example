# swift-os website — frontend (SvelteKit) environment

# Strapi CMS REST base URL (server-side fetches). No trailing slash.
STRAPI_URL=http://localhost:1337

# Optional read-only API token. If the content types are publicly readable
# (the seeded default), this can be left blank.
STRAPI_TOKEN=

# Path to the swift-os docs/ directory that the docs reader ingests, resolved
# relative to the web app cwd (apps/web). swift-os/docs is three levels up.
DOCS_DIR=../../../docs

# Public repo base used for "Edit on GitHub" links.
PUBLIC_REPO_URL=https://github.com/asaptf/swift-os

# Absolute site origin for canonical URLs, Open Graph, sitemap.xml, robots.txt.
# Required for the static build (ADAPTER=static); the Node build falls back to
# the request origin. No trailing slash. e.g. https://swift-os.dev
PUBLIC_SITE_URL=

# --- In-browser QEMU (WASM) ---
# Base URL the pinned emulator artifacts are served from
# (qemu-system-aarch64.{js,wasm,worker.js,data}). Same-origin recommended, e.g.
# "/qemu". Leave EMPTY to fall back to the recorded boot on /try.
PUBLIC_QEMU_WASM_BASE=
# Pinned artifact version (cache-bust + provenance), e.g. the CI build's git sha.
PUBLIC_QEMU_WASM_VERSION=
# Approx first-run download size shown on the gate.
PUBLIC_QEMU_WASM_SIZE_MB=~30
