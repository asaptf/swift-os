{
  "schemaVersion": 1,
  "name": "tzdata",
  "version": "2026b",
  "revision": 1,
  "category": "sysutils",
  "summary": "IANA time zone database compiled into zoneinfo files",
  "homepage": "https://www.iana.org/time-zones",
  "license": ["Public-Domain"],
  "maturity": "packages",
  "source": {
    "url": "https://data.iana.org/time-zones/releases/tzdata2026b.tar.gz",
    "sha256": "114543d9f19a6bfeb5bca43686aea173d38755a3db1f2eec112647ae92c6f544"
  },
  "target": {
    "arch": "aarch64",
    "os": "swift-os",
    "abi": "swos-0",
    "libc": "newlib-4.6-swos",
    "linkage": "static"
  },
  "build": {
    "system": "data-zic",
    "args": ["zic", "-d", "${DESTDIR}/usr/share/zoneinfo"],
    "env": {}
  },
  "install": {
    "destdir": true,
    "command": ["stage", "zoneinfo"]
  },
  "package": {
    "depends": [],
    "provides": ["tzdata", "zoneinfo"],
    "conflicts": [],
    "files": [
      { "type": "tree", "from": "destdir/usr/share/zoneinfo", "to": "/usr/share/zoneinfo", "mode": "0644" }
    ],
    "capabilities": {
      "default": [],
      "services": []
    }
  },
  "test": {
    "qemu": [
      "cat /usr/share/zoneinfo/swiftos-tzdata.version",
      "cat /usr/share/zoneinfo/zone1970.tab"
    ]
  },
  "notes": "Data-only package. scripts/build-tzdata.sh uses the host zic tool to compile portable TZif zoneinfo files and stages IANA metadata plus a swift-os version marker."
}
