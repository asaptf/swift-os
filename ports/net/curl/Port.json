{
  "schemaVersion": 1,
  "name": "curl",
  "version": "8.20.0",
  "revision": 1,
  "category": "net",
  "summary": "HTTP client for SwiftOS administration and package repository diagnostics",
  "homepage": "https://curl.se/",
  "license": ["curl"],
  "maturity": "packages",
  "source": {
    "url": "https://curl.se/download/curl-8.20.0.tar.xz",
    "sha256": "63fe2dc148ba0ceae89922ef838f7e5c946272c2e78b7c59fab4b79d3ce2b896"
  },
  "target": {
    "arch": "aarch64",
    "os": "swift-os",
    "abi": "swos-0",
    "libc": "newlib-4.6-swos",
    "linkage": "static"
  },
  "build": {
    "system": "configure-make",
    "args": [
      "--host=aarch64-swiftos",
      "--target=aarch64-swiftos",
      "--prefix=/usr",
      "--disable-shared",
      "--enable-static",
      "--without-ssl",
      "--without-zlib",
      "--without-libpsl",
      "--without-libidn2",
      "--without-brotli",
      "--without-zstd",
      "--without-nghttp2",
      "--without-nghttp3",
      "--without-ngtcp2",
      "--without-quiche",
      "--without-gssapi",
      "--without-librtmp",
      "--disable-dict",
      "--disable-file",
      "--disable-ftp",
      "--disable-gopher",
      "--disable-imap",
      "--disable-ldap",
      "--disable-ldaps",
      "--disable-mqtt",
      "--disable-pop3",
      "--disable-rtsp",
      "--disable-smb",
      "--disable-smtp",
      "--disable-telnet",
      "--disable-tftp",
      "--disable-ipfs",
      "--disable-websockets",
      "--disable-manual",
      "--disable-docs",
      "--disable-threaded-resolver",
      "--disable-ipv6"
    ],
    "env": {
      "AR": "aarch64-elf-ar",
      "CC": "aarch64-elf-gcc",
      "CPPFLAGS": "-isystem ${SWOS_ROOT}/userland/compat -isystem ${SYSROOT}/include",
      "CFLAGS": "-ffreestanding -Os",
      "LDFLAGS": "-static -nostartfiles -nostdlib -T ${SWOS_ROOT}/userland/user_newlib.ld -Wl,-z,max-page-size=4096 ${RUNTIME}/crt0_newlib.o ${RUNTIME}/newlib_syscalls.o ${RUNTIME}/compat_stubs.o -L${SYSROOT}/lib",
      "LIBS": "-Wl,--start-group -lc -lgcc -Wl,--end-group",
      "RANLIB": "aarch64-elf-ranlib"
    }
  },
  "install": {
    "destdir": true,
    "command": ["make", "install", "stage-version-marker"]
  },
  "package": {
    "depends": [],
    "provides": ["curl", "libcurl"],
    "conflicts": [],
    "files": [
      { "from": "destdir/usr/bin/curl", "to": "/usr/bin/curl", "mode": "0755" },
      { "from": "destdir/usr/include/curl/curl.h", "to": "/usr/include/curl/curl.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/curlver.h", "to": "/usr/include/curl/curlver.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/easy.h", "to": "/usr/include/curl/easy.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/header.h", "to": "/usr/include/curl/header.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/mprintf.h", "to": "/usr/include/curl/mprintf.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/multi.h", "to": "/usr/include/curl/multi.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/options.h", "to": "/usr/include/curl/options.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/stdcheaders.h", "to": "/usr/include/curl/stdcheaders.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/system.h", "to": "/usr/include/curl/system.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/typecheck-gcc.h", "to": "/usr/include/curl/typecheck-gcc.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/urlapi.h", "to": "/usr/include/curl/urlapi.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/websockets.h", "to": "/usr/include/curl/websockets.h", "mode": "0644" },
      { "from": "destdir/usr/lib/libcurl.a", "to": "/usr/lib/libcurl.a", "mode": "0644" },
      { "from": "destdir/usr/lib/pkgconfig/libcurl.pc", "to": "/usr/lib/pkgconfig/libcurl.pc", "mode": "0644" },
      { "from": "destdir/usr/share/curl/swiftos-curl.version", "to": "/usr/share/curl/swiftos-curl.version", "mode": "0644" }
    ],
    "capabilities": {
      "default": [],
      "services": ["dns", "tcp-client"]
    }
  },
  "test": {
    "qemu": [
      "/usr/bin/curl --version",
      "/usr/bin/curl -fsS http://10.0.2.2:18080/curl-fixture.txt"
    ]
  },
  "notes": "First packaged curl is source-built as a static HTTP-only client plus libcurl.a and public headers. HTTPS/TLS is deliberately deferred until the OpenSSL headers/static libraries move into an openssl-dev split package and the target TLS/time/entropy smoke can validate certificate chains. FTP, mail, SMB, RTSP, TFTP, MQTT, IPFS, WebSockets, HTTP/2, HTTP/3, IDN, brotli, zstd, zlib compression, GSSAPI, libpsl, threaded resolver support, and IPv6 are disabled for the first package."
}
