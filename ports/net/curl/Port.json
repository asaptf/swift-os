{
  "schemaVersion": 1,
  "name": "curl",
  "version": "8.20.0",
  "revision": 1,
  "category": "net",
  "summary": "HTTP and HTTPS client for SwiftOS administration and scripts",
  "homepage": "https://curl.se/",
  "license": ["curl"],
  "maturity": "scaffolded",
  "source": {
    "url": "https://curl.se/download/curl-8.20.0.tar.xz",
    "sha256": "63fe2dc148ba0ceae89922ef838f7e5c946272c2e78b7c59fab4b79d3ce2b896"
  },
  "target": {
    "arch": "aarch64",
    "os": "swift-os",
    "abi": "swos-0",
    "libc": "newlib-4.6-swos",
    "linkage": "static"
  },
  "build": {
    "system": "configure-make",
    "args": [
      "--host=aarch64-swiftos",
      "--target=aarch64-swiftos",
      "--prefix=/usr",
      "--disable-shared",
      "--enable-static",
      "--with-openssl",
      "--with-ca-bundle=/usr/etc/ssl/cert.pem",
      "--without-libpsl",
      "--without-libidn2",
      "--without-brotli",
      "--without-zstd",
      "--without-nghttp2",
      "--without-nghttp3",
      "--without-ngtcp2",
      "--without-quiche",
      "--without-gssapi",
      "--without-librtmp",
      "--disable-dict",
      "--disable-file",
      "--disable-ftp",
      "--disable-gopher",
      "--disable-imap",
      "--disable-ldap",
      "--disable-ldaps",
      "--disable-mqtt",
      "--disable-pop3",
      "--disable-rtsp",
      "--disable-smb",
      "--disable-smtp",
      "--disable-telnet",
      "--disable-tftp",
      "--disable-manual",
      "--disable-threaded-resolver"
    ],
    "env": {
      "AR": "aarch64-elf-ar",
      "CC": "aarch64-elf-gcc",
      "CPPFLAGS": "-isystem ${PORTS_ROOT}/openssl/usr/include -isystem ${PORTS_ROOT}/zlib/usr/include -isystem ${SWOS_ROOT}/userland/compat -isystem ${SYSROOT}/include",
      "CFLAGS": "-ffreestanding -Os",
      "LDFLAGS": "-static -nostartfiles -nostdlib -T ${SWOS_ROOT}/userland/user_newlib.ld -Wl,-z,max-page-size=4096 ${RUNTIME}/crt0_newlib.o ${RUNTIME}/newlib_syscalls.o ${RUNTIME}/compat_stubs.o -L${PORTS_ROOT}/openssl/usr/lib -L${PORTS_ROOT}/zlib/usr/lib -L${SYSROOT}/lib",
      "LIBS": "-Wl,--start-group -lssl -lcrypto -lz -lc -lgcc -Wl,--end-group",
      "PKG_CONFIG_PATH": "${PORTS_ROOT}/openssl/usr/lib/pkgconfig:${PORTS_ROOT}/zlib/usr/lib/pkgconfig",
      "RANLIB": "aarch64-elf-ranlib"
    }
  },
  "install": {
    "destdir": true,
    "command": ["make", "install", "stage-version-marker"]
  },
  "package": {
    "depends": ["ca-certificates", "openssl", "zlib"],
    "provides": ["curl", "libcurl"],
    "conflicts": [],
    "files": [
      { "from": "destdir/usr/bin/curl", "to": "/usr/bin/curl", "mode": "0755" },
      { "from": "destdir/usr/include/curl/curl.h", "to": "/usr/include/curl/curl.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/curlver.h", "to": "/usr/include/curl/curlver.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/easy.h", "to": "/usr/include/curl/easy.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/header.h", "to": "/usr/include/curl/header.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/mprintf.h", "to": "/usr/include/curl/mprintf.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/multi.h", "to": "/usr/include/curl/multi.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/options.h", "to": "/usr/include/curl/options.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/stdcheaders.h", "to": "/usr/include/curl/stdcheaders.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/system.h", "to": "/usr/include/curl/system.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/typecheck-gcc.h", "to": "/usr/include/curl/typecheck-gcc.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/urlapi.h", "to": "/usr/include/curl/urlapi.h", "mode": "0644" },
      { "from": "destdir/usr/include/curl/websockets.h", "to": "/usr/include/curl/websockets.h", "mode": "0644" },
      { "from": "destdir/usr/lib/libcurl.a", "to": "/usr/lib/libcurl.a", "mode": "0644" },
      { "from": "destdir/usr/lib/pkgconfig/libcurl.pc", "to": "/usr/lib/pkgconfig/libcurl.pc", "mode": "0644" },
      { "from": "destdir/usr/share/curl/swiftos-curl.version", "to": "/usr/share/curl/swiftos-curl.version", "mode": "0644" }
    ],
    "capabilities": {
      "default": [],
      "services": ["dns", "tcp-client", "tls-client"]
    }
  },
  "test": {
    "qemu": [
      "/usr/bin/curl --version",
      "/usr/bin/curl -fsS http://10.0.2.2:18080/curl-fixture.txt"
    ]
  },
  "notes": "Scaffold only. The first SwiftOS curl package should be source-built and statically linked against the packaged OpenSSL and zlib roots, with the CLI and libcurl.a shipped together because static application ports need development artifacts. The initial protocol surface is HTTP/HTTPS only: FTP, mail, SMB, RTSP, TFTP, MQTT, HTTP/2, HTTP/3, IDN, brotli, zstd, GSSAPI, libpsl, and threaded resolver support are deliberately disabled until the dependency and runtime surfaces are reviewed. A package build script and QEMU HTTP/HTTPS smoke are the next promotion step before changing the catalog status to packages."
}
